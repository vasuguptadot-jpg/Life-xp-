# ============================================================================
# LifeXP — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# On Replit, set these as Secrets (padlock icon) or environment variables.
# DATABASE_URL and PG* variables are automatically managed by Replit — do not
# set them manually.
# ============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (auto-managed by Replit's built-in database)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign and verify JWT access tokens.
# Generate a strong random value: `openssl rand -base64 64`
SESSION_SECRET=replace-with-a-long-random-secret

# ── Server ────────────────────────────────────────────────────────────────────

# Port the API server listens on (auto-set by Replit per-artifact)
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# ── Replit-managed (do not set manually) ─────────────────────────────────────

# These are injected automatically by Replit's runtime and database layer.
# Listing them here for documentation purposes only.
#
# PGHOST=...
# PGPORT=5432
# PGUSER=...
# PGPASSWORD=...
# PGDATABASE=...
# REPLIT_DEV_DOMAIN=...
# REPL_ID=...
# BASE_PATH=...       (per-artifact, set by artifact workflow)

# ── Optional ─────────────────────────────────────────────────────────────────

# Log level for pino: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
