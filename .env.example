# ============================================================================
# LifeXP — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# On Replit, set these as Secrets (padlock icon) or environment variables.
# DATABASE_URL and PG* variables are automatically managed by Replit — do not
# set them manually.
#
# NEVER commit real secrets. This file contains safe example values only.
#
# Legend:
#   [REQUIRED]          — the API server will refuse to start without it.
#   [FEATURE-SPECIFIC]  — enables a specific feature; the app boots and other
#                         features work fully when unset.
#   [OPTIONAL]          — has a safe default; setting it changes behavior.
# ============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (auto-managed by Replit's built-in database).
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname
# [REQUIRED]

# Secret used to sign and verify JWT access tokens.
# Generate a strong random value: `openssl rand -base64 64`
# The API server refuses to start without this value set.
SESSION_SECRET=replace-with-a-long-random-secret
# [REQUIRED]

# ── FEATURE-SPECIFIC ────────────────────────────────────────────────────────

# Groq API key for the AI coach, daily tasks, and life tips.
# The server boots and every non-AI feature works without it:
#   - POST /api/ai/chat        -> 503 "AI coach is not configured…"
#   - GET  /api/ai/daily-tasks -> [] (no tasks generated)
#   - GET  /api/ai/life-tip    -> static fallback tip
# With a valid key, the AI endpoints call Groq for real generations.
GROQ_API_KEY=
# [FEATURE-SPECIFIC — AI coach / daily tasks / life tips]

# ── SERVER ───────────────────────────────────────────────────────────────────

# Port the API server listens on (auto-set by Replit per-artifact).
# The server refuses to start without it; Replit injects it automatically.
PORT=5000
# [REQUIRED — auto-managed by Replit]

# Node environment: development | production | test
NODE_ENV=development
# [OPTIONAL]

# Log level for pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# [OPTIONAL]

# ── WEB / VITE ───────────────────────────────────────────────────────────────

# Base path the web app is served under (required by vite.config.ts).
# On Replit this is auto-set per-artifact; "/" for root deployment.
BASE_PATH=/
# [OPTIONAL]

# ── CORS (production) ────────────────────────────────────────────────────────

# Comma-separated allow-list of origins permitted in production.
# When unset or in non-production, the API allows same-origin / all origins.
CORS_ORIGINS=https://your-app.example.com
# [OPTIONAL]

# ── OBJECT STORAGE (Replit sidecar) ──────────────────────────────────────────

# Comma-separated list of public object-search paths exposed to clients.
# Used by lib/objectStorage.ts to classify public vs. private objects.
PUBLIC_OBJECT_SEARCH_PATHS=
# [FEATURE-SPECIFIC — object storage ACL classification]

# Directory prefix for private objects (bucket/dir layout).
# Used by lib/objectStorage.ts to build private object paths.
PRIVATE_OBJECT_DIR=
# [FEATURE-SPECIFIC — object storage ACL classification]

# ── REPLIT-MANAGED (do not set manually) ─────────────────────────────────────

# These are injected automatically by Replit's runtime and database layer.
# Listing them here for documentation purposes only.
#
# PGHOST=...
# PGPORT=5432
# PGUSER=...
# PGPASSWORD=...
# PGDATABASE=...
# REPLIT_DEV_DOMAIN=...
# REPL_ID=...         (Replit deployment id, used by Vite dev plugins)
# BASE_PATH=...       (per-artifact, set by artifact workflow)
