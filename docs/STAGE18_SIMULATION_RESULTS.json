  "defects": [
    {
      "id": 1,
      "class": "D",
      "title": "Momentum mislabeled 'stable' for long-inactive users",
      "file": "artifacts/api-server/src/lib/life-engine/momentum-engine.ts",
      "reproduce": "user with totalXp=100 and zero activity in last 14 days => score 0, direction 'stable'",
      "root_cause": "direction only set 'falling' when priorXp>0; fell through to 'stable' when both windows empty",
      "fix": "else if (recentXp===0 && priorXp===0 && state.totalXp>0) direction='falling'",
      "regression_test": "longitudinal-simulation.test.ts: momentum rising/falling; B-inactive recovery"
    },
    {
      "id": 2,
      "class": "D",
      "title": "Stale abandoned quests keep a weakness flagged forever",
      "file": "artifacts/api-server/src/lib/life-engine/weakness-engine.ts",
      "reproduce": "persona G fails 10 quests then is perfect 19 days; day 29 still 'STRENGTH:30 - 10 abandoned strength quests'",
      "root_cause": "abandoned-quest count had no recency window, unlike recovery/behavior/difficulty (all 30d)",
      "fix": "only count abandoned quests with assignedAt >= now-30d",
      "regression_test": "longitudinal-simulation.test.ts: weakness clears at day 39"
    },
    {
      "id": 3,
      "class": "D",
      "title": "Concurrent awardXp loses XP updates",
      "file": "artifacts/api-server/src/lib/progression.ts",
      "reproduce": "20 concurrent awardXp(50 XP) => totalXp 250 instead of 1100 (lost updates)",
      "root_cause": "non-atomic read-modify-write on user_levels.totalXp under READ COMMITTED",
      "fix": "atomic INSERT..ON CONFLICT DO UPDATE SET totalXp = user_levels.totalXp + $xp RETURNING; level recomputed in follow-up write",
      "regression_test": "longitudinal-db.test.ts: concurrent awardXp exact total"
    }
  ],
